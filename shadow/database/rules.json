{
  "version": "1.0.0",
  "last_updated": "2025-01-15",
  "description": "Security rules for Linux hardening - Complete coverage for all modules",

  "rules": {
    "ssh": {
      "SSH-001": {
        "name": "PermitRootLogin",
        "expected": "no",
        "severity": "high",
        "category": "authentication",
        "compliance": ["CIS-5.2.8"],
        "cve": [],
        "description": "Root login should be disabled to prevent direct root attacks",
        "fix": "Set PermitRootLogin no in /etc/ssh/sshd_config",
        "check_command": "grep -E '^PermitRootLogin no' /etc/ssh/sshd_config"
      },
      "SSH-002": {
        "name": "MaxAuthTries",
        "expected": 3,
        "severity": "high",
        "category": "authentication",
        "compliance": ["CIS-5.2.10"],
        "cve": ["CVE-2018-15473"],
        "description": "Maximum authentication attempts should be limited to prevent brute force",
        "fix": "Set MaxAuthTries 3 in /etc/ssh/sshd_config",
        "check_command": "grep -E '^MaxAuthTries 3' /etc/ssh/sshd_config"
      },
      "SSH-003": {
        "name": "Protocol",
        "expected": 2,
        "severity": "critical",
        "category": "authentication",
        "compliance": ["CIS-5.2.1"],
        "cve": ["CVE-2001-0572"],
        "description": "SSH protocol 1 is insecure and should not be used",
        "fix": "Set Protocol 2 in /etc/ssh/sshd_config",
        "check_command": "grep -E '^Protocol 2' /etc/ssh/sshd_config"
      },
      "SSH-004": {
        "name": "PasswordAuthentication",
        "expected": "yes",
        "severity": "medium",
        "category": "authentication",
        "compliance": ["CIS-5.2.12"],
        "cve": [],
        "description": "Password authentication should be enabled for fallback",
        "fix": "Set PasswordAuthentication yes in /etc/ssh/sshd_config",
        "check_command": "grep -E '^PasswordAuthentication yes' /etc/ssh/sshd_config"
      },
      "SSH-005": {
        "name": "ChallengeResponseAuthentication",
        "expected": "no",
        "severity": "medium",
        "category": "authentication",
        "compliance": ["CIS-5.2.11"],
        "cve": [],
        "description": "Challenge response authentication is less secure",
        "fix": "Set ChallengeResponseAuthentication no in /etc/ssh/sshd_config",
        "check_command": "grep -E '^ChallengeResponseAuthentication no' /etc/ssh/sshd_config"
      },
      "SSH-006": {
        "name": "X11Forwarding",
        "expected": "no",
        "severity": "low",
        "category": "network",
        "compliance": ["CIS-5.2.5"],
        "cve": [],
        "description": "X11 forwarding should be disabled unless required",
        "fix": "Set X11Forwarding no in /etc/ssh/sshd_config",
        "check_command": "grep -E '^X11Forwarding no' /etc/ssh/sshd_config"
      },
      "SSH-007": {
        "name": "Banner",
        "expected": "/etc/issue.net",
        "severity": "low",
        "category": "authentication",
        "compliance": ["CIS-5.2.15"],
        "cve": [],
        "description": "SSH banner should be displayed to warn unauthorized users",
        "fix": "Set Banner /etc/issue.net in /etc/ssh/sshd_config",
        "check_command": "grep -E '^Banner /etc/issue.net' /etc/ssh/sshd_config"
      },
      "SSH-008": {
        "name": "MaxSessions",
        "expected": 10,
        "severity": "medium",
        "category": "authentication",
        "compliance": ["CIS-5.2.9"],
        "cve": [],
        "description": "Maximum SSH sessions should be limited",
        "fix": "Set MaxSessions 10 in /etc/ssh/sshd_config",
        "check_command": "grep -E '^MaxSessions 10' /etc/ssh/sshd_config"
      }
    },

    "password": {
      "PASS-001": {
        "name": "min_length",
        "expected": 8,
        "severity": "high",
        "category": "authentication",
        "compliance": ["CIS-5.3.1"],
        "cve": [],
        "description": "Minimum password length should be at least 8 characters",
        "fix": "Set PASS_MIN_LEN 8 in /etc/login.defs",
        "check_command": "grep -E '^PASS_MIN_LEN 8' /etc/login.defs"
      },
      "PASS-002": {
        "name": "max_age",
        "expected": 90,
        "severity": "medium",
        "category": "authentication",
        "compliance": ["CIS-5.3.2"],
        "cve": [],
        "description": "Passwords should expire after 90 days",
        "fix": "Set PASS_MAX_DAYS 90 in /etc/login.defs",
        "check_command": "grep -E '^PASS_MAX_DAYS 90' /etc/login.defs"
      },
      "PASS-003": {
        "name": "min_age",
        "expected": 1,
        "severity": "low",
        "category": "authentication",
        "compliance": ["CIS-5.3.2"],
        "cve": [],
        "description": "Minimum days between password changes should be 1",
        "fix": "Set PASS_MIN_DAYS 1 in /etc/login.defs",
        "check_command": "grep -E '^PASS_MIN_DAYS 1' /etc/login.defs"
      },
      "PASS-004": {
        "name": "warn_age",
        "expected": 7,
        "severity": "low",
        "category": "authentication",
        "compliance": ["CIS-5.3.2"],
        "cve": [],
        "description": "Users should be warned 7 days before password expiry",
        "fix": "Set PASS_WARN_AGE 7 in /etc/login.defs",
        "check_command": "grep -E '^PASS_WARN_AGE 7' /etc/login.defs"
      },
      "PASS-005": {
        "name": "max_attempts",
        "expected": 3,
        "severity": "critical",
        "category": "authentication",
        "compliance": ["CIS-5.3.3"],
        "cve": [],
        "description": "Account should lock after 3 failed login attempts",
        "fix": "Configure pam_faillock with deny=3 in /etc/pam.d/common-password",
        "check_command": "grep -E 'pam_faillock.*deny=3' /etc/pam.d/common-password"
      },
      "PASS-006": {
        "name": "lockout_time",
        "expected": 600,
        "severity": "critical",
        "category": "authentication",
        "compliance": ["CIS-5.3.3"],
        "cve": [],
        "description": "Account should be locked for 10 minutes after 3 failed attempts",
        "fix": "Configure pam_faillock with unlock_time=600 in /etc/pam.d/common-password",
        "check_command": "grep -E 'pam_faillock.*unlock_time=600' /etc/pam.d/common-password"
      },
      "PASS-007": {
        "name": "complexity",
        "expected": true,
        "severity": "high",
        "category": "authentication",
        "compliance": ["CIS-5.3.1"],
        "cve": [],
        "description": "Password complexity should be enforced (upper, lower, digit, special)",
        "fix": "Configure pam_pwquality with minlen=8, ucredit=-1, lcredit=-1, dcredit=-1, ocredit=-1",
        "check_command": "grep -E 'pam_pwquality' /etc/pam.d/common-password"
      },
      "PASS-008": {
        "name": "history",
        "expected": 5,
        "severity": "medium",
        "category": "authentication",
        "compliance": ["CIS-5.3.4"],
        "cve": [],
        "description": "Password history should be enforced to prevent password reuse",
        "fix": "Configure pam_pwhistory with remember=5 in /etc/pam.d/common-password",
        "check_command": "grep -E 'pam_pwhistory.*remember=5' /etc/pam.d/common-password"
      }
    },

    "firewall": {
