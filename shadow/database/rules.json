        "compliance": ["CIS-3.4.1"],
        "cve": [],
        "description": "Firewall should be active to protect the system",
        "fix": "Enable firewall with ufw enable or iptables",
        "check_command": "ufw status | grep -E 'Status: active'"
      },
      "FW-002": {
        "name": "default_policy",
        "expected": "deny",
        "severity": "high",
        "category": "network",
        "compliance": ["CIS-3.4.2"],
        "cve": [],
        "description": "Default firewall policy should be deny",
        "fix": "Set default policy to deny with ufw default deny",
        "check_command": "ufw status verbose | grep -E 'Default: deny'"
      },
      "FW-003": {
        "name": "logging",
        "expected": true,
        "severity": "medium",
        "category": "monitoring",
