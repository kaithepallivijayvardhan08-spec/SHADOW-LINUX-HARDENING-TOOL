    "users": {
      "USER-001": {
        "name": "uid0_check",
        "expected": "only_root",
        "severity": "critical",
        "category": "authentication",
        "compliance": ["CIS-6.2.1"],
        "cve": [],
        "description": "Only root should have UID 0",
        "fix": "Remove or change UID of any other user with UID 0",
        "check_command": "grep -E '^[^:]*:0:' /etc/passwd | grep -v root"
      },
      "USER-002": {
        "name": "empty_password",
        "expected": "none",
        "severity": "critical",
        "category": "authentication",
        "compliance": ["CIS-6.2.2"],
        "cve": [],
        "description": "No user should have an empty password",
        "fix": "Lock or set password for users with empty passwords",
        "check_command": "grep -E '^[^:]*::' /etc/shadow"
      },
      "USER-003": {
        "name": "root_login",
        "expected": false,
        "severity": "high",
        "category": "authentication",
        "compliance": ["CIS-6.2.3"],
        "cve": [],
        "description": "Root should not be able to login directly",
        "fix": "Set PermitRootLogin no in /etc/ssh/sshd_config",
        "check_command": "grep -E '^PermitRootLogin no' /etc/ssh/sshd_config"
      }
    },

    "file_security": {
